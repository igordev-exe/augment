{
  "name": "augment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AUGMENT: app de treino de hipertrofia com estética cyberpunk. Ficha, cargas, timer, histórico, recordes e guia científico.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --base ./ && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "vite-node scripts/lint.ts",
    "icons": "python3 scripts/make-icons.py .",
    "format": "prettier --write .",
    "check": "tsc -b && tsc -p server && vite-node scripts/lint.ts && prettier --check . && vitest run",
    "coach": "vite-node scripts/coach.ts",
    "server": "vite-node server/src/node.ts",
    "server:deploy": "cd server && npx wrangler deploy",
    "build:ios": "tsc -b && vite build --base ./ && cap sync ios",
    "ios:open": "cap open ios",
    "verify:layout": "node tools/verify/audit.mjs",
    "verify:keyframes": "node tools/verify/keyframes.mjs",
    "verify:e2e": "node tools/verify/e2e.mjs http://localhost:5173 tools/verify/out/e2e",
    "verify:webkit": "node tools/verify/webkit.mjs http://localhost:5173 tools/verify/out/webkit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@fontsource/exo-2": "5.2.5",
    "@fontsource/orbitron": "5.2.5",
    "@fontsource/rajdhani": "5.2.5",
    "@fontsource/share-tech-mono": "5.2.5",
    "augmented-ui": "2.0.0",
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
