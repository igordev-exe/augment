{
  "name": "augment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AUGMENT: app pessoal de treino de hipertrofia com estética cyberpunk. Ficha, cargas, timer, histórico, recordes e guia científico.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "vite-node scripts/lint.ts",
    "icons": "python3 scripts/make-icons.py .",
    "format": "prettier --write .",
    "check": "tsc -b && vite-node scripts/lint.ts && prettier --check . && vitest run",
    "coach": "vite-node scripts/coach.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource/exo-2": "5.2.5",
    "@fontsource/orbitron": "5.2.5",
    "@fontsource/share-tech-mono": "5.2.5",
    "augmented-ui": "2.0.0",
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
